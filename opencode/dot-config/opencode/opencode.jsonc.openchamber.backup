{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "servers": {
      "datadog": {
        "type": "remote",
        "url": "https://mcp.us5.datadoghq.com/v1/mcp?toolsets=core,dashboards,widgets,code-exec",
        "disabled": false
      }
    }
  }
}