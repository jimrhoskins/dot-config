{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "linear": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ],
    },
    "datadog": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp"
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    }
  }
}
