{
  "$schema": "https://opencode.ai/config.json",
  "model": "aperture-anthropic/claude-fable-5",
  "providers": {
    "aperture-anthropic": {
      "package": "aisdk:@ai-sdk/anthropic",
      "name": "Aperture (Claude API)",
      "settings": {
        "baseURL": "https://aperture.tail8deb1.ts.net/v1",
        "apiKey": "not-required"
      },
      "models": {
        "claude-fable-5": {
          "name": "claude-fable-5",
          "capabilities": { "tools": true }
        },
        "claude-haiku-4-5": {
          "name": "claude-haiku-4-5",
          "capabilities": { "tools": true }
        },
        "claude-haiku-4-5-20251001": {
          "name": "claude-haiku-4-5-20251001",
          "capabilities": { "tools": true }
        },
        "claude-opus-4-7": {
          "name": "claude-opus-4-7",
          "capabilities": { "tools": true }
        },
        "claude-opus-4-8": {
          "name": "claude-opus-4-8",
          "capabilities": { "tools": true }
        },
        "claude-opus-5": {
          "name": "claude-opus-5",
          "capabilities": { "tools": true }
        },
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6",
          "capabilities": { "tools": true }
        },
        "claude-sonnet-5": {
          "name": "claude-sonnet-5",
          "capabilities": { "tools": true }
        },
        "deepseek/deepseek-v4.1-flash": {
          "name": "deepseek/deepseek-v4.1-flash",
          "capabilities": { "tools": true }
        },
        "openai/gpt-5.6-luna": {
          "name": "openai/gpt-5.6-luna",
          "capabilities": { "tools": true }
        }
      }
    },
    "aperture-openai": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "Aperture (Responses API)",
      "settings": {
        "baseURL": "https://aperture.tail8deb1.ts.net/v1",
        "apiKey": "not-required"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "deepseek/deepseek-v4.1-flash",
          "capabilities": { "tools": true }
        },
        "openai/gpt-5.6-luna": {
          "name": "openai/gpt-5.6-luna",
          "capabilities": { "tools": true }
        }
      }
    },
    "aperture-openai-compatible": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Aperture (Completions API)",
      "settings": {
        "baseURL": "https://aperture.tail8deb1.ts.net/v1",
        "apiKey": "not-required"
      },
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "name": "deepseek/deepseek-v4.1-flash",
          "capabilities": { "tools": true }
        },
        "openai/gpt-5.6-luna": {
          "name": "openai/gpt-5.6-luna",
          "capabilities": { "tools": true }
        }
      }
    }
  },
  "mcp": {
    "linear": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp"
    },
    "servers": {
      "aperture": {
        "type": "remote",
        "url": "https://aperture.tail8deb1.ts.net/v1/mcp"
      },
      "datadog": {
        "type": "remote",
        "url": "https://mcp.us5.datadoghq.com/v1/mcp",
        "disabled": false
      }
    }
  }
}
