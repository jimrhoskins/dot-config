assume-admin() {
  local role_arn="arn:aws:iam::964351313027:role/AssumeAdministratorAccess"
  local mfa_arn="arn:aws:iam::964351313027:mfa/Bitwarden"
  local item="${BW_AWS_TOTP_ITEM:-AWS IAM}"
  local token
  local credentials

  unset AWS_PROFILE AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN

  token="$(bw get totp "$item")" || {
    print -u2 "Could not retrieve the Bitwarden TOTP."
    return 1
  }

  credentials="$(aws sts assume-role \
    --profile default \
    --role-arn "$role_arn" \
    --role-session-name "kinfra-terraform-$(date +%Y%m%d%H%M%S)" \
    --serial-number "$mfa_arn" \
    --token-code "$token" \
    --duration-seconds 3600 \
    --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
    --output text)" || {
      unset token
      return 1
    }

  read -r AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN <<< "$credentials"
  export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
  export AWS_REGION="us-east-1"

  unset token credentials

  aws sts get-caller-identity
}

admin() {
  local item="${BW_AWS_TOTP_ITEM:-AWS IAM}"

  unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
  export AWS_PROFILE=admin
  export AWS_REGION=us-east-1

  setopt localoptions pipefail
  bw get totp "$item" | pbcopy || {
    print -u2 "Could not retrieve the Bitwarden TOTP."
    return 1
  }

  print "MFA code copied to clipboard. Paste it when AWS CLI prompts."
  aws sts get-caller-identity
}
