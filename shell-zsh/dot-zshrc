    echo $KUBETOKEN | clip.exe
    echo https://127.0.0.1:8443/
    kubectl -n kubernetes-dashboard port-forward $POD_NAME 8443:8443
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

